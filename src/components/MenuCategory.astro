---
import type { MenuCategory as MenuCategoryType } from "@/data/menu";

type Props = {
  category: MenuCategoryType;
};

const { category } = Astro.props;
---

<details class="menu-category group">
  <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 marker:content-none sm:px-6 sm:py-5">
    <div>
      <h3 class="font-display text-xl font-bold uppercase leading-none text-charcoal sm:text-2xl">{category.name}</h3>
      {category.note && <p class="mt-1.5 text-xs leading-relaxed text-charcoal/68">{category.note}</p>}
    </div>
    <span class="menu-toggle-icon grid size-8 shrink-0 place-items-center border border-red/25 text-red group-open:rotate-45" aria-hidden="true">
      <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M12 5v14M5 12h14" /></svg>
    </span>
  </summary>
  <div class="border-t border-charcoal/10 px-5 py-5 sm:px-6">
    <ul class="grid gap-x-10 gap-y-4 sm:grid-cols-2">
      {category.items.map((item) => (
        <li class="grid grid-cols-[1fr_auto] items-baseline gap-x-4">
          <div class="min-w-0">
            <p class="text-sm font-medium leading-snug text-charcoal sm:text-[0.9375rem]">
              {item.name}
              {item.spicy && <span class="ml-1 text-red" title="Hot and spicy" aria-label="Hot and spicy">◆</span>}
            </p>
            {item.description && <p class="mt-1 max-w-sm text-xs leading-relaxed text-charcoal/68">{item.description}</p>}
          </div>
          <span class="font-mono text-sm tabular-nums text-red">{item.price}</span>
        </li>
      ))}
    </ul>
  </div>
</details>
