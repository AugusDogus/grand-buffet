---
import MenuCategory from "@/components/MenuCategory.astro";
import { dinnerSpecials, menuCategories } from "@/data/menu";
import { onlineOrderLinks } from "@/data/site";
import SiteLayout from "@/layouts/SiteLayout.astro";

const title = "Takeout Menu | Grand Buffet in Pace, FL";
const description = "Browse Grand Buffet’s complete takeout menu, including appetizers, noodles, rice, chicken, beef, seafood, chef’s specials, sushi rolls, and dinner specials.";
const menuColumnBreak = Math.ceil(menuCategories.length / 2);
const menuColumns = [menuCategories.slice(0, menuColumnBreak), menuCategories.slice(menuColumnBreak)];
---

<SiteLayout title={title} description={description}>
  <section id="menu" class="bg-white px-4 pb-14 pt-10 sm:px-6 sm:pb-18 sm:pt-12 md:px-8 md:pb-20 md:pt-14 lg:px-10 lg:pb-24 lg:pt-16 xl:px-12 2xl:px-16">
    <div class="mx-auto max-w-[82rem]">
      <a href="/" class="pressable inline-flex min-h-11 items-center gap-2 text-sm font-semibold text-charcoal/60 hover:text-red">
        <svg viewBox="0 0 20 20" class="size-4" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M16 10H4M9 5l-5 5 5 5" /></svg>
        Back to home
      </a>

      <div class="mt-7 grid gap-6 md:grid-cols-[1fr_auto] md:items-end">
        <div>
          <p class="section-label">Takeout menu</p>
          <h1 class="mt-3 max-w-4xl font-display text-5xl font-extrabold uppercase leading-none sm:text-6xl md:text-7xl">Order from the full menu</h1>
          <p class="mt-4 max-w-2xl text-sm leading-6 text-charcoal/68 sm:text-base">Select a category to see every item and price. A diamond marks hot and spicy dishes.</p>
        </div>
        <div class="flex flex-wrap gap-2 md:w-40 md:flex-col">
          <a href={onlineOrderLinks.pickup} target="_blank" rel="noopener noreferrer" class="pressable inline-flex h-12 items-center justify-center gap-2 rounded-md border border-red/25 px-5 text-sm font-bold text-red hover:border-red hover:bg-sand" aria-label="Order pickup with Uber Eats (opens in a new tab)">
            Order pickup
            <svg viewBox="0 0 16 16" class="size-3" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M5 3h8v8M13 3 4 12" /></svg>
          </a>
          <a href={onlineOrderLinks.delivery} target="_blank" rel="noopener noreferrer" class="pressable inline-flex h-12 items-center justify-center gap-2 rounded-md bg-red px-5 text-sm font-bold text-white hover:bg-red-dark" aria-label="Order delivery with Uber Eats (opens in a new tab)">
            Order delivery
            <svg viewBox="0 0 16 16" class="size-3" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M5 3h8v8M13 3 4 12" /></svg>
          </a>
        </div>
      </div>

      <div class="mt-10 overflow-hidden border-2 border-red bg-red text-white xl:grid xl:grid-cols-[19rem_1fr]">
        <div class="border-b border-white/20 p-5 sm:p-7 md:p-8 xl:border-r xl:border-b-0">
          <p class="text-[0.6875rem] font-bold uppercase tracking-[0.11em] text-yellow">Complete meal</p>
          <h2 class="mt-3 font-display text-4xl font-extrabold uppercase leading-none sm:text-5xl">Dinner special</h2>
          <p class="mt-3 font-display text-6xl font-extrabold leading-none text-yellow">$9.25</p>
          <p class="mt-4 max-w-xs text-sm leading-6 text-white/78">Each entrée includes pork fried rice and an egg roll.</p>
        </div>
        <ul class="columns-1 gap-x-10 p-5 text-sm sm:columns-2 sm:p-7 md:p-8">
          {dinnerSpecials.map((item) => (
            <li class="mb-2.5 break-inside-avoid border-b border-white/12 pb-2.5 leading-5 text-white/88 last:border-b-0">
              {item.spicy && <span class="mr-1.5 text-yellow" aria-label="Hot and spicy">◆</span>}{item.name}
            </li>
          ))}
        </ul>
      </div>

      <div class="mt-10 flex items-end justify-between gap-6 border-b-2 border-charcoal pb-4">
        <div>
          <p class="section-label">À la carte</p>
          <h2 class="mt-2 font-display text-3xl font-extrabold uppercase leading-none sm:text-4xl">Browse by category</h2>
        </div>
        <p class="hidden text-sm text-charcoal/60 sm:block">{menuCategories.length} categories</p>
      </div>

      <div class="menu-grid mt-4">
        {menuColumns.map((column) => (
          <div class="grid content-start gap-3">
            {column.map((category) => <MenuCategory category={category} />)}
          </div>
        ))}
      </div>

      <div class="mt-8 border-l-4 border-yellow bg-sand px-5 py-4 text-sm leading-6 text-charcoal/68">
        <strong class="text-charcoal">Food allergies:</strong> Tell the owner, manager, chef, or your server before ordering. Consuming raw or undercooked meat, poultry, seafood, shellfish, or eggs may increase your risk of foodborne illness.
      </div>
    </div>
  </section>
</SiteLayout>
