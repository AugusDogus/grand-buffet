---
import { Picture } from "astro:assets";
import { ActionLink } from "@/components/ActionLink";
import SiteLayout from "@/layouts/SiteLayout.astro";
import heroImage from "@/assets/grand-buffet-spread.png";
import { directionsUrl, onlineOrderLinks, phoneHref } from "@/data/site";

const title = "Chinese Buffet in Pace, FL | Grand Buffet";
const description = "Grand Buffet serves Chinese food, sushi, and hibachi in Pace, FL. See buffet prices, the takeout menu, hours, and directions. Open daily at 11 AM.";
---

<SiteLayout title={title} description={description}>
      <section class="bg-white">
        <div class="mx-auto grid max-w-[90rem] lg:min-h-[600px] lg:grid-cols-[0.9fr_1.1fr] xl:min-h-[650px] 2xl:min-h-[680px]">
          <div class="flex items-center px-4 py-14 sm:px-6 sm:py-18 md:px-8 md:py-20 lg:px-10 lg:py-24 xl:px-12 2xl:px-16">
            <div class="max-w-2xl">
              <p class="section-label">4210 Highway 90 · Pace, FL</p>
              <h1 class="mt-5 text-balance font-display text-[3rem] font-extrabold uppercase leading-[0.94] tracking-[-0.02em] text-charcoal sm:text-[3.5rem] md:text-[4rem] lg:text-[4.25rem] xl:text-[4.75rem] 2xl:text-[5.25rem]">
                Chinese buffet, sushi, and hibachi in Pace.
              </h1>
              <p class="mt-6 max-w-xl text-pretty text-base leading-7 text-charcoal/68 sm:text-lg">
                Stop in for lunch or dinner, or call ahead for takeout. The buffet includes Chinese favorites, seafood, vegetables, sushi, and hibachi.
              </p>
              <div class="mt-8 flex flex-col gap-3 sm:flex-row">
                <ActionLink href={phoneHref} label="Call Grand Buffet" className="h-12 rounded-md bg-red px-6 text-sm font-bold text-white active:scale-[.97] hover:bg-red-dark">
                  Call (850) 994-3333
                </ActionLink>
                <ActionLink href={directionsUrl} label="Get directions to Grand Buffet" variant="outline" className="h-12 rounded-md border-charcoal/25 bg-white px-6 text-sm font-bold text-charcoal active:scale-[.97] hover:bg-sand">
                  Get directions
                </ActionLink>
              </div>
              <dl class="mt-10 grid max-w-lg grid-cols-2 gap-x-6 gap-y-5 border-t border-charcoal/15 pt-6 text-sm sm:grid-cols-3">
                <div>
                  <dt class="fact-label">Sun–Thu</dt>
                  <dd class="mt-1 font-bold">11 AM–9 PM</dd>
                </div>
                <div>
                  <dt class="fact-label">Fri–Sat</dt>
                  <dd class="mt-1 font-bold">11 AM–10 PM</dd>
                </div>
                <div class="col-span-2 sm:col-span-1">
                  <dt class="fact-label">Takeout</dt>
                  <dd class="mt-1 font-bold">Available daily</dd>
                </div>
              </dl>
            </div>
          </div>

          <div class="relative min-h-[310px] overflow-hidden bg-charcoal sm:min-h-[420px] lg:min-h-full">
            <Picture
              src={heroImage}
              formats={["avif"]}
              fallbackFormat="webp"
              widths={[640, 960, 1280, 1600]}
              sizes="(max-width: 1023px) 100vw, 55vw"
              alt="General Tso’s chicken, lo mein, fried rice, spring rolls, beef and broccoli, and sushi"
              class="absolute inset-0 h-full w-full object-cover object-center"
              pictureAttributes={{ class: "absolute inset-0" }}
              priority
            />
            <div class="absolute bottom-4 left-4 right-4 grid grid-cols-2 overflow-hidden rounded-md bg-white shadow-xl sm:bottom-6 sm:left-6 sm:right-auto sm:w-[23rem] lg:bottom-8 lg:left-8 xl:bottom-10 xl:left-10">
              <a href="#buffet" class="hero-price pressable border-r border-charcoal/12">
                <span>Lunch buffet</span>
                <strong>$11.99</strong>
              </a>
              <a href="#buffet" class="hero-price pressable">
                <span>Dinner buffet</span>
                <strong>$14.99</strong>
              </a>
            </div>
          </div>
        </div>
      </section>

      <section class="border-y border-charcoal/12 bg-yellow">
        <div class="mx-auto grid max-w-[90rem] grid-cols-2 md:grid-cols-4">
          {[
            ["Lunch", "Mon–Sat until 4 PM"],
            ["Dinner", "Mon–Sat after 4 PM"],
            ["Sunday", "Dinner price all day"],
            ["Carryout", "Buffet boxes by the pound"],
          ].map(([title, copy], index) => (
            <div class:list={["quick-fact", index < 2 && "border-b md:border-b-0"]}>
              <strong>{title}</strong>
              <span>{copy}</span>
            </div>
          ))}
        </div>
      </section>

      <section id="buffet" tabindex="-1" class="scroll-mt-4 px-4 py-16 sm:px-6 sm:py-20 md:px-8 md:py-24 lg:px-10 lg:py-28 xl:px-12 2xl:px-16">
        <div class="mx-auto max-w-[82rem]">
          <div class="grid gap-5 border-b-2 border-charcoal pb-7 md:grid-cols-[1fr_auto] md:items-end">
            <div>
              <p class="section-label">Buffet prices</p>
              <h2 class="mt-3 font-display text-5xl font-extrabold uppercase leading-none sm:text-6xl md:text-7xl">Lunch, dinner, and Sunday</h2>
            </div>
            <p class="max-w-sm text-sm leading-6 text-charcoal/68 md:text-right">Kids’ prices are for ages 3–9.</p>
          </div>

          <div class="grid border-b border-charcoal/20 md:grid-cols-3">
            <article class="buffet-price border-b border-charcoal/20 md:border-b-0 md:border-r">
              <div>
                <p class="fact-label">Mon–Sat · 11 AM–4 PM</p>
                <h3>Lunch</h3>
              </div>
              <p class="big-price"><sup>$</sup>11.99</p>
              <dl>
                <div><dt>Ages 3–5</dt><dd>$5.99</dd></div>
                <div><dt>Ages 6–9</dt><dd>$6.99</dd></div>
              </dl>
            </article>
            <article class="buffet-price border-b border-charcoal/20 md:border-b-0 md:border-r">
              <div>
                <p class="fact-label">Mon–Sat · 4 PM–close</p>
                <h3>Dinner</h3>
              </div>
              <p class="big-price"><sup>$</sup>14.99</p>
              <dl>
                <div><dt>Ages 3–5</dt><dd>$6.99</dd></div>
                <div><dt>Ages 6–9</dt><dd>$7.99</dd></div>
              </dl>
            </article>
            <article class="buffet-price">
              <div>
                <p class="fact-label">Sunday · 11 AM–9 PM</p>
                <h3>All day</h3>
              </div>
              <p class="big-price"><sup>$</sup>14.99</p>
              <p class="text-sm leading-6 text-charcoal/68">Dinner buffet price and selection all day Sunday.</p>
            </article>
          </div>

          <div class="grid gap-px bg-charcoal/15 sm:grid-cols-2 lg:grid-cols-4">
            {[
              ["Carryout lunch", "$6.99/lb"],
              ["Carryout dinner", "$7.99/lb"],
              ["Carryout sushi", "$0.70/piece"],
              ["Soda, free refills", "$2.59"],
            ].map(([label, price]) => (
              <div class="flex items-center justify-between gap-4 bg-white px-5 py-5 lg:block lg:px-6 lg:py-6">
                <p class="fact-label">{label}</p>
                <p class="font-display text-2xl font-bold lg:mt-2">{price}</p>
              </div>
            ))}
          </div>
          <p class="mt-4 text-xs leading-5 text-charcoal/68">Prices are subject to change. Call for current pricing.</p>
        </div>
      </section>

      <section id="menu" tabindex="-1" class="scroll-mt-4 bg-charcoal px-4 py-14 text-white sm:px-6 sm:py-16 md:px-8 md:py-20 lg:px-10 xl:px-12 2xl:px-16">
        <div class="mx-auto grid max-w-[82rem] gap-8 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-end lg:gap-16">
          <div>
            <p class="text-[0.6875rem] font-bold uppercase tracking-[0.11em] text-yellow">Takeout menu</p>
            <h2 class="mt-3 max-w-4xl font-display text-5xl font-extrabold uppercase leading-none sm:text-6xl">Find your takeout favorites</h2>
            <p class="mt-5 max-w-3xl text-sm leading-6 text-white/65 sm:text-base">Appetizers, noodles, chef’s specials, sushi, and more. See every dish and price on our full takeout menu.</p>
          </div>
          <a href="/menu/" class="pressable inline-flex h-12 w-fit items-center justify-center gap-2 rounded-md bg-yellow px-6 text-sm font-bold text-charcoal hover:bg-white">
            Browse the menu
            <svg viewBox="0 0 20 20" class="size-4" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M4 10h12M11 5l5 5-5 5" /></svg>
          </a>
        </div>
      </section>

      <section id="visit" tabindex="-1" class="scroll-mt-4 px-4 py-16 sm:px-6 sm:py-20 md:px-8 md:py-24 lg:px-10 lg:py-28 xl:px-12 2xl:px-16">
        <div class="mx-auto grid max-w-[82rem] border-2 border-charcoal bg-white lg:grid-cols-2">
          <div class="p-6 sm:p-9 md:p-11 lg:p-12 xl:p-14">
            <p class="section-label">Hours & location</p>
            <h2 class="mt-3 font-display text-5xl font-extrabold uppercase leading-none sm:text-6xl">Grand Buffet in Pace</h2>
            <address class="mt-7 not-italic">
              <p class="text-lg font-bold">4210 Highway 90</p>
              <p class="mt-1 text-charcoal/68">Pace, FL 32571</p>
            </address>
            <a href={phoneHref} class="pressable mt-4 inline-flex min-h-11 items-center text-xl font-bold text-red underline decoration-red/25 underline-offset-4 hover:decoration-red">(850) 994-3333</a>

            <dl class="mt-8 grid gap-5 border-t border-charcoal/15 pt-7 sm:grid-cols-2">
              <div>
                <dt class="fact-label">Sunday–Thursday</dt>
                <dd class="mt-1 font-display text-2xl font-bold">11 AM–9 PM</dd>
              </div>
              <div>
                <dt class="fact-label">Friday–Saturday</dt>
                <dd class="mt-1 font-display text-2xl font-bold">11 AM–10 PM</dd>
              </div>
            </dl>
          </div>

          <div class="location-panel flex min-h-[360px] items-end bg-red p-6 text-white sm:min-h-[420px] sm:p-9 md:p-11 lg:min-h-full lg:p-12 xl:p-14">
            <div>
              <svg viewBox="0 0 24 24" class="size-10 text-yellow" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z" /><circle cx="12" cy="10" r="2.5" /></svg>
              <p class="mt-5 max-w-sm font-display text-4xl font-bold uppercase leading-none sm:text-5xl">On Highway 90 near West Spencer Field Road.</p>
              <div class="mt-7 flex flex-wrap gap-2">
                <a href={directionsUrl} class="pressable inline-flex h-11 items-center justify-center rounded-md bg-white px-4 text-sm font-bold text-red hover:bg-yellow hover:text-charcoal">Get directions</a>
                <a href={onlineOrderLinks.pickup} target="_blank" rel="noopener noreferrer" class="pressable inline-flex h-11 items-center justify-center gap-2 rounded-md bg-yellow px-4 text-sm font-bold text-charcoal hover:bg-white" aria-label="Order pickup with Uber Eats (opens in a new tab)">
                  Order pickup
                  <svg viewBox="0 0 16 16" class="size-3" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M5 3h8v8M13 3 4 12" /></svg>
                </a>
                <a href={onlineOrderLinks.delivery} target="_blank" rel="noopener noreferrer" class="pressable inline-flex h-11 items-center justify-center gap-2 rounded-md border border-white/25 px-4 text-sm font-bold text-white hover:border-white hover:bg-white hover:text-red" aria-label="Order delivery with Uber Eats (opens in a new tab)">
                  Order delivery
                  <svg viewBox="0 0 16 16" class="size-3" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M5 3h8v8M13 3 4 12" /></svg>
                </a>
              </div>
            </div>
          </div>
        </div>
      </section>
</SiteLayout>
